APP_NAME=Kaiarasa
APP_ENV=production
APP_KEY=kaiarasa_official_secret_key_32bytes
APP_DEBUG=false

# Cloudflare Turnstile (anti-bot halaman login)
# Ambil kunci di: Cloudflare Dashboard -> Turnstile -> Add site.
# Kosongkan kedua nilai untuk menonaktifkan verifikasi.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Database
DB_PATH=/app/Database/database.sqlite
